{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucc.dev/schemas/artifact.schema.json",
  "title": "ucc.artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "id", "created_at", "created_by", "record_version",
    "artifact_type", "title", "lifecycle"
  ],
  "properties": {
    "schema": {"const": "ucc.artifact"},
    "schema_version": {"const": 1},
    "id": {
      "allOf": [
        {"$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"},
        {"pattern": "^art_"}
      ]
    },
    "created_at": {"$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/timestamp"},
    "created_by": {"$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"},
    "record_version": {"type": "integer", "minimum": 1},
    "artifact_type": {"const": "script"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 4096},
    "lifecycle": {"type": "string", "enum": ["active", "archived"]}
  }
}
