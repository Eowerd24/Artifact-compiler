{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucc.dev/schemas/verification.schema.json",
  "title": "ucc.verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "id", "created_at", "created_by", "record_version",
    "revision_id", "content_hash", "verification_state"
  ],
  "properties": {
    "schema": {"const": "ucc.verification"},
    "schema_version": {"const": 1},
    "id": {
      "allOf": [
        {"$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"},
        {"pattern": "^ver_"}
      ]
    },
    "created_at": {"$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/timestamp"},
    "created_by": {"$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"},
    "record_version": {"const": 1},
    "revision_id": {
      "allOf": [
        {"$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"},
        {"pattern": "^rev_"}
      ]
    },
    "content_hash": {"$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/hash"},
    "verification_state": {
      "type": "string",
      "enum": ["not_required", "pending", "passed", "failed", "expired"]
    },
    "evidence": {"type": "object"},
    "reason": {"type": "string", "maxLength": 4096}
  }
}
