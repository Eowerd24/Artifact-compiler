{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucc.dev/schemas/credential-lease.schema.json",
  "title": "ucc.credential-lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "created_at",
    "created_by",
    "record_version",
    "node_id",
    "credential_ref",
    "lease_phase",
    "target_path",
    "leased_at"
  ],
  "properties": {
    "schema": {
      "const": "ucc.credential-lease"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"
        },
        {
          "pattern": "^cred_"
        }
      ]
    },
    "created_at": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "node_id": {
      "allOf": [
        {
          "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"
        },
        {
          "pattern": "^node_"
        }
      ]
    },
    "credential_ref": {
      "type": "string",
      "minLength": 1
    },
    "lease_phase": {
      "type": "string",
      "enum": [
        "requested",
        "active",
        "cleanup_pending",
        "closed",
        "refused",
        "expired_unverified",
        "cleanup_failed",
        "quarantined"
      ]
    },
    "target_path": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/relpath"
    },
    "scope": {
      "type": "string"
    },
    "leased_at": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/timestamp"
    },
    "cleaned_up_at": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/timestamp"
    },
    "cleanup_evidence": {
      "type": "object"
    }
  }
}
