{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucc.dev/schemas/node-manifest.schema.json",
  "title": "ucc.node-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "created_at",
    "created_by",
    "record_version",
    "name",
    "arch",
    "cpu_cores",
    "ram_mb",
    "disk_gb",
    "ip",
    "ssh_user"
  ],
  "properties": {
    "schema": {
      "const": "ucc.node-manifest"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"
        },
        {
          "pattern": "^node_"
        }
      ]
    },
    "created_at": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "arch": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "cpu_cores": {
      "type": "integer",
      "minimum": 1
    },
    "ram_mb": {
      "type": "integer",
      "minimum": 256
    },
    "disk_gb": {
      "type": "integer",
      "minimum": 1
    },
    "ip": {
      "type": "string",
      "minLength": 1
    },
    "ssh_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "ssh_user": {
      "type": "string",
      "minLength": 1
    },
    "ssh_key_path": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/relpath"
    },
    "host_key": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
