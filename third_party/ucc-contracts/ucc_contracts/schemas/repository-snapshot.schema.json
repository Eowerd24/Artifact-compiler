{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucc.dev/schemas/repository-snapshot.schema.json",
  "title": "ucc.repository-snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "created_at",
    "created_by",
    "record_version",
    "repository_id",
    "commit_sha",
    "tree_hash"
  ],
  "properties": {
    "schema": {
      "const": "ucc.repository-snapshot"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"
        },
        {
          "pattern": "^snap_"
        }
      ]
    },
    "created_at": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "repository_id": {
      "allOf": [
        {
          "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/id"
        },
        {
          "pattern": "^col_"
        }
      ]
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree_hash": {
      "$ref": "https://ucc.dev/schemas/common.schema.json#/$defs/hash"
    }
  }
}
